render ok: true
toml-begin
# generated by himari-gate; do not edit

[global]
log = "warn"
unmatched = "close"

[ca]
cert_path = ""
key_path = ""
common_name = "Himari Local CA"
leaf_validity_days = 90
install_to_system_root = false

[store]
enabled = true
dir = ""
renew_margin_days = 15

[cache]
capacity = 2048
ttl_secs = 21600

[psl]
source = "embedded"

[[listener]]
addr = "127.0.0.1:51033"

  [[listener.route]]
  name = "manual-wire"
  type = "tls"
  match_sni = ["packtest.invalid"]
  upstream = "127.0.0.1:51032"
  override_sni = "spoofed.test"
  fail = "close"
toml-end
